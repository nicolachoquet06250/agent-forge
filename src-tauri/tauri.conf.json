{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Forge",
  "version": "../package.json",
  "identifier": "fr.nicolaschoquet.agentforge",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 4321",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Forge",
        "url": "/",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Éditeur local d'agents IA et de skills Markdown.",
    "longDescription": "Agent Forge permet de créer, valider, prévisualiser et exporter des agents IA et des Agent Skills au format Markdown.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
